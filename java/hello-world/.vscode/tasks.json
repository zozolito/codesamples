{
    "version": "2.0.0",
    "tasks": [
        {
            // ─────────────────────────────────────────────────────────────────
            // Compile
            // javac compiles Java source files to .class bytecode files.
            // -d bin       → place .class files in the bin/ directory
            // -encoding UTF-8 → source files are UTF-8
            // -source 17   → target Java 17 language features
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding", "UTF-8",
                "-source",   "17",
                "-target",   "17",
                "-d",        "${workspaceFolder}/bin",
                "${workspaceFolder}/src/HelloWorld.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$javac"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Run
            // java runs the JVM and executes the compiled class.
            // -cp bin  → the classpath: where to find .class files
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Run",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp", "${workspaceFolder}/bin",
                "HelloWorld"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "Java: Compile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Single-file run (Java 11+)
            // Since Java 11, you can run a single .java file directly
            // without a separate compile step — useful for quick experiments.
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Run single file (Java 11+)",
            "type": "shell",
            "command": "java",
            "args": [
                "${workspaceFolder}/src/HelloWorld.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Compile with verbose output — shows all class loading & compilation
            // Useful for understanding what the compiler does under the hood.
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Compile (verbose)",
            "type": "shell",
            "command": "javac",
            "args": [
                "-verbose",
                "-encoding", "UTF-8",
                "-d",        "${workspaceFolder}/bin",
                "${workspaceFolder}/src/HelloWorld.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$javac"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Decompile bytecode — shows the bytecode instructions
            // javap -c disassembles the .class file into bytecode mnemonics.
            // This is NOT machine code — it's JVM bytecode (platform-neutral).
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Disassemble bytecode (javap)",
            "type": "shell",
            "command": "javap",
            "args": [
                "-c",       // show bytecode
                "-p",       // show private members too
                "-classpath", "${workspaceFolder}/bin",
                "HelloWorld"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Java: Compile",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Show JVM flags — what flags is the JVM using by default?
            // -XX:+PrintFlagsFinal shows all JVM options and their values.
            // -version exits immediately after setup.
            // ─────────────────────────────────────────────────────────────────
            "label": "Java: Show JVM version and info",
            "type": "shell",
            "command": "java",
            "args": [
                "-version",
                "-XshowSettings:all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
