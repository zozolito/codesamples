{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "COBOL: Debug (GDB — Linux / macOS / WSL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/hello",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "COBOL: Build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "moduleLoad": false,
                "trace": false
            }
        },
        {
            "name": "COBOL: Run without debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/hello",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "preLaunchTask": "COBOL: Build",
            "logging": {
                "moduleLoad": false
            }
        }
    ]
}
