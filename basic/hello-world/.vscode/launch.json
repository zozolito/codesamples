{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BASIC: Debug (GDB — Linux / macOS / WSL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/hello",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "BASIC: Build (FreeBASIC — Linux / macOS)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "moduleLoad": false
            }
        }
    ]
}
