{
    "files.associations": {
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.h":   "cpp"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.compilerArgs": [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "-fsanitize=address,undefined"
    ],
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64"
}
